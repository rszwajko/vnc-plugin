{
  "name": "vnc-plugin",
  "displayName": "VNC plugin",
  "version": "0.0.5",
  "description": "VNC plugin",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rszwajko/vnc-plugin.git"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production npm run webpack",
    "build-dev": "npm run clean && npm run webpack",
    "start": "npm run webpack serve",
    "start-console": "./start-console.sh",
    "lint": "eslint src",
    "webpack": "ts-node -O '{\"module\":\"commonjs\"}' node_modules/.bin/webpack"
  },
  "dependencies": {
    "@patternfly/react-icons": "6.4.0",
    "@rszwajko/standalone": "1.6.0-rc.2",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.21.0",
    "@openshift-console/dynamic-plugin-sdk-internal": "4.21.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.21.0",
    "@types/node": "18.19.130",
    "@types/react": "17.0.90",
    "@types/react-dom": "17.0.26",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "copy-webpack-plugin": "11.0.0",
    "css-loader": "6.11.0",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "husky": "9.1.7",
    "lint-staged": "13.3.0",
    "prettier": "2.8.8",
    "style-loader": "3.3.4",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "webpack": "5.104.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.3"
  },
  "engines": {
    "node": ">=18.20.5",
    "npm": "^9.5.0 || >=10.5.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx)": [
      "prettier --write --ignore-unknown"
    ]
  }
}
