{
  "name": "vnc-plugin",
  "displayName": "VNC plugin",
  "version": "0.0.8",
  "description": "VNC plugin",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rszwajko/vnc-plugin.git"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production npm run webpack",
    "build-dev": "npm run clean && npm run webpack",
    "start": "npm run webpack serve",
    "start-console": "./start-console.sh",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "webpack": "ts-node -O '{\"module\":\"commonjs\"}' node_modules/.bin/webpack"
  },
  "dependencies": {
    "@patternfly/react-icons": "6.4.0",
    "@rszwajko/standalone": "1.6.0-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@openshift-console/dynamic-plugin-sdk": "4.23.0",
    "@openshift-console/dynamic-plugin-sdk-internal": "4.23.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.23.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "css-loader": "6.11.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "2.8.8",
    "style-loader": "3.3.4",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.5.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx)": [
      "prettier --write --ignore-unknown"
    ]
  }
}
