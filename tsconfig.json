{
  "$schema": "https://schemastore.org/tsconfig",

  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "lib": ["es2021", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2021",
    "typeRoots": ["node_modules/@types", "@types"]
  },
  "include": ["src/**/*", "images/**/*", "plugin-metadata.ts", "plugin-extensions.ts"]
}
